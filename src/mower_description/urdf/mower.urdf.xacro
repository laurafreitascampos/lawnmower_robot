<?xml version="1.0"?>
<!--
  Robô cortador de grama - chassi 4 rodas skid-steer + LiDAR LD19

  Dimensões aproximadas (cortador residencial pequeno):
    - Chassi: 40cm (compr) x 30cm (larg) x 15cm (alt)
    - Rodas: 10cm diâmetro, 4cm largura
    - Massa total: ~10kg

  LiDAR LD19 montado no topo, 5cm acima do chassi.
  Specs do LD19 (extraídas do datasheet):
    - 360° FOV horizontal
    - 4500 samples/segundo
    - 10Hz rotação
    - Alcance: ~0.02m a ~12m
-->
<robot name="mower" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ PARÂMETROS ============ -->
  <xacro:property name="chassis_length" value="0.40"/>
  <xacro:property name="chassis_width"  value="0.30"/>
  <xacro:property name="chassis_height" value="0.15"/>
  <xacro:property name="chassis_mass"   value="8.0"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheel_mass"   value="0.5"/>

  <!-- Distância entre rodas (eixos) -->
  <xacro:property name="wheel_separation_x" value="0.25"/>  <!-- frente-trás -->
  <xacro:property name="wheel_separation_y" value="0.32"/>  <!-- esquerda-direita -->

  <xacro:property name="lidar_radius" value="0.0375"/>  <!-- LD19 ~75mm diâm. -->
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass"   value="0.1"/>

  <!-- ============ MACROS ============ -->

  <!-- Macro pra inércia de uma caixa -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- Macro pra inércia de um cilindro (eixo Y, rodas) -->
  <xacro:macro name="cylinder_inertia_y" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12}" ixy="0" ixz="0"
               iyy="${m*r*r/2}"           iyz="0"
               izz="${m*(3*r*r+l*l)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- Macro pra inércia de um cilindro (eixo Z, LiDAR) -->
  <xacro:macro name="cylinder_inertia_z" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+l*l)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- Macro pra criar uma roda -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia_y m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- Atrito alto pra rodas terem boa tração no Gazebo -->
    <gazebo reference="${name}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <!-- ============ CHASSI ============ -->

  <!-- base_footprint: ponto no chão, embaixo do robô. Padrão ROS. -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="green"><color rgba="0.2 0.6 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}"
                       x="${chassis_length}"
                       y="${chassis_width}"
                       z="${chassis_height}"/>
  </link>

  <!-- ============ RODAS ============ -->
  <!-- Posições: x positivo = frente, y positivo = esquerda -->
  <xacro:wheel name="front_left"  x=" ${wheel_separation_x/2}" y=" ${wheel_separation_y/2}"/>
  <xacro:wheel name="front_right" x=" ${wheel_separation_x/2}" y="-${wheel_separation_y/2}"/>
  <xacro:wheel name="rear_left"   x="-${wheel_separation_x/2}" y=" ${wheel_separation_y/2}"/>
  <xacro:wheel name="rear_right"  x="-${wheel_separation_x/2}" y="-${wheel_separation_y/2}"/>

  <!-- ============ LIDAR ============ -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="dark_gray"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia_z m="${lidar_mass}" r="${lidar_radius}" l="${lidar_height}"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- LiDAR montado no centro do chassi, 5cm acima do topo -->
    <origin xyz="0 0 ${chassis_height + 0.10}" rpy="0 0 0"/>
  </joint>

  <!-- ============ PLUGINS GAZEBO ============ -->

  <!-- Plugin do LiDAR com specs do LD19 real -->
  <gazebo reference="lidar_link">
    <sensor name="ld19_lidar" type="gpu_lidar">
      <pose>0 0 ${lidar_height/2} 0 0 0</pose>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>     <!-- LD19 = 10Hz -->
      <lidar>
        <scan>
          <horizontal>
            <samples>450</samples>       <!-- 4500 pts/s ÷ 10Hz = 450 pts/scan -->
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.02</min>                <!-- mínimo do LD19 -->
          <max>12.0</max>                <!-- máximo do LD19 -->
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>          <!-- 1cm de ruído, realista -->
        </noise>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- Plugin de skid-steer: 4 rodas controladas como diferencial -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <!-- Pares de rodas: o plugin trata os dois lados como "uma roda virtual" -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>${wheel_separation_y}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <!-- Limites de velocidade (m/s e rad/s) -->
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>

      <!-- Tópicos ROS2 padrão -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- Plugin que publica os estados das juntas -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
